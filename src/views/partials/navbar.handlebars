                background: none;
                padding: 0;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: text-shadow 0.25s ease;
            " onmouseover="this.style.textShadow='0 0 8px rgba(255,255,255,0.6)'" onmouseout="this.style.textShadow='none'">
