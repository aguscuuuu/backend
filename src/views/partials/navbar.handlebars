<nav style="
    background: linear-gradient(60deg, #0b3866 0%, #28517a 100%);
    padding: 8px max(30px, calc((100% - 1200px) / 2));
    border-bottom: 4px solid #ec9a00;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 15px 0;
    width: 100%;
    border-radius: 0 !important;
">
    {{#if user.isAdmin}}
    <!-- navbar admin (una sola fila) -->
    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="/" style="
                color: #ffffff;
                font-weight: 600;
                font-size: 24px;
                letter-spacing: 0.5px;
                text-decoration: none;
                background: none;
                padding: 0;
                display: flex;
                align-items: center;
                gap: 8px;
            ">
                <img src="/icon.svg" alt="Logo Vertex" style="height: 30px; width: auto; background: #ffffff; padding: 5px; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                Vertex
            </a>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <span style="
                color: #ffffff;
                font-weight: 500;
                font-size: 12px;
                cursor: default;
            ">{{user.first_name}}</span>
            <a href="/logout" style="
                background: #ec9a00;
                color: #ffffff;
                padding: 6px 12px;
                border-radius: 6px;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
            ">Cerrar sesión</a>
        </div>
    </div>
    {{else}}
    <!-- navbar clientes -->
    <!-- FILA 1: logo + buscador (centrado) -->
    <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; width: 100%;">
        <a href="/" style="
            color: #ffffff;
            font-weight: 600;
            font-size: 32px;
            letter-spacing: 0px;
            text-decoration: none;
            background: none;
            padding: 0;
            justify-self: start;
            display: flex;
            align-items: center;
            gap: 10px;
        ">
            <img src="/icon.svg" alt="Logo Vertex" style="height: 38px; width: auto; background: #ffffff; padding: 6px; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
            Vertex
        </a>

        <form action="/" method="GET" style="display: flex; width: clamp(200px, 40vw, 550px);">
            <input type="text" name="query" placeholder="Buscar productos..." value="{{query}}" style="
                flex: 1;
                border: none;
                outline: none;
                padding: 10px 16px;
                border-radius: 6px 0 0 6px;
                font-size: 12px;
                color: #1f2933;
                background-color: #ffffff;
            ">
            <button type="submit" aria-label="Buscar" style="
                background-color: #ec9a00;
                border: none;
                padding: 8px 14px;
                border-radius: 0 6px 6px 0;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.25s ease;
            " onmouseover="this.style.backgroundColor='#d18900'" onmouseout="this.style.backgroundColor='#ec9a00'">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </form>
    </div>

    <!-- FILA 2: opciones + autenticación -->
    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 10px;">
        <!-- opciones -->
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a href="/?query=Periféricos" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Periféricos</a>

            <a href="/?query=Monitores" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Monitores</a>

            <a href="/?query=Audio" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Audio</a>

            <a href="/?query=Almacenamiento" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Almacenamiento</a>

            <a href="/?query=Muebles" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Muebles</a>

            <a href="/?query=Accesorios" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Accesorios</a>
        </div>

        <!-- autenticación (a la par de las opciones) -->
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        {{#if user}}
                <!-- cliente sesión iniciada -->
                <button onclick="goToCart()" style="
                    background: none;
                    color: #e5e7eb;
                    border: none;
                    cursor: pointer;
                    font-weight: 500;
                    font-size: 12px;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    transition: color 0.25s ease;
                " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span id="cartQuantity" style="min-width: 20px;">0</span>
                </button>

                <span style="
                    color: #ffffff;
                    font-weight: 500;
                    font-size: 12px;
                    cursor: default;
                ">{{user.first_name}}</span>

                <a href="/logout" style="
                    background: #ec9a00;
                    color: #ffffff;
                    padding: 6px 12px;
                    border-radius: 6px;
                    text-decoration: none;
                    font-weight: 500;
                    font-size: 12px;
                ">Cerrar sesión</a>
        {{else}}
            <!-- no hay sesión iniciada -->
            <button onclick="goToCart()" style="
                background: none;
                color: #e5e7eb;
                border: none;
                cursor: pointer;
                font-weight: 500;
                font-size: 12px;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span id="cartQuantity" style="min-width: 20px;">0</span>
            </button>

            <a href="/login" style="
                color: #e5e7eb;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                background: none;
                padding: 6px 12px;
                border-radius: 0;
                transition: color 0.25s ease;
            " onmouseover="this.style.color='#ec9a00'" onmouseout="this.style.color='#e5e7eb'">Iniciar sesión</a>

            <a href="/register" style="
                background: #ec9a00;
                color: #ffffff;
                padding: 6px 12px;
                border-radius: 6px;
                text-decoration: none;
                font-weight: 500;
                font-size: 12px;
                transition: background-color 0.25s ease;
            " onmouseover="this.style.backgroundColor='#d18900'" onmouseout="this.style.backgroundColor='#ec9a00'">Crear cuenta</a>
        {{/if}}
        </div>
    </div>
    {{/if}}
</nav>

{{#unless user.isAdmin}}
<script>
    window.addEventListener('DOMContentLoaded', async () => {
        const cart = await ensureCartExists();
        renderCartQuantity(cart);
    });

    async function ensureCartExists() {
        let cartId = localStorage.getItem('cartId');

        if (cartId) {
            try {
                const response = await fetch(`/api/carts/${cartId}`);
                if (!response.ok) {
                    cartId = null;
                    localStorage.removeItem('cartId');
                } else {
                    const data = await response.json();
                    return data.data;
                }
            } catch {
                cartId = null;
                localStorage.removeItem('cartId');
            }
        }

        try {
            const response = await fetch('/api/carts', { method: 'POST' });
            const data = await response.json();
            cartId = data.data._id;
            localStorage.setItem('cartId', cartId);
            return data.data;
        } catch (error) {
            console.error('Error al crear carrito:', error);
            return null;
        }
    }

    function renderCartQuantity(cart) {
        if (!cart?.products) return;
        const total = cart.products.reduce((sum, item) => sum + item.quantity, 0);
        const el = document.getElementById('cartQuantity');
        if (el) el.textContent = total;
    }

    async function goToCart() {
        const cart = await ensureCartExists();
        if (cart?._id) {
            window.location.href = `/carts/${cart._id}`;
        }
    }

    window.addToCartGlobal = async function(productId) {
        const cart = await ensureCartExists();
        const cartId = cart?._id;
        
        try {
            const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
                method: 'POST'
            });
            const data = await response.json();
            
            if (data.status === 'success') {
                window.location.href = `/carts/${cartId}`;
            } else {
                alert('Error: ' + data.message);
            }
        } catch (error) {
            alert('Error al agregar al carrito');
        }
    };
</script>
{{/unless}}