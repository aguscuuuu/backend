<div aria-label="breadcrumb" style="margin-bottom: 12px; font-size: 0.8rem; color: #999;">
    <a href="/" style="color: inherit; text-decoration: none; background: none; padding: 0;">Inicio</a>
    /
    <a href="/?query={{product.category}}" style="color: inherit; text-decoration: none; background: none; padding: 0;">{{product.category}}</a>
    /
    {{product.title}}
</div>

<div style="max-width: 1100px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; align-items: start;">

        <!-- galería de imágenes -->
        <div style="padding-right: 40px; border-right: 1px solid #e8e8e8;">
            {{#if product.thumbnails.[0]}}
                <div class="media-frame" style="width: 100%; aspect-ratio: 1 / 1; border-radius: 5px; overflow: hidden;">
                    <div class="media-loader"><span class="media-spinner"></span></div>
                    <img
                        id="mainImage"
                        src="{{product.thumbnails.[0]}}"
                        alt="{{product.title}}"
                        onload="this.classList.add('loaded'); this.previousElementSibling.classList.add('hidden')"
                        onerror="this.classList.add('loaded'); this.previousElementSibling.classList.add('hidden')"
                        style="width: 100%; height: 100%; object-fit: contain; border-radius: 5px;"
                    >
                </div>
                {{#if product.hasGallery}}
                <div style="display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap;">
                    {{#each product.thumbnails}}
                    <img
                        src="{{this}}"
                        alt="miniatura"
                        onclick="var m=document.getElementById('mainImage'); m.classList.remove('loaded'); m.previousElementSibling.classList.remove('hidden'); m.src='{{this}}'"
                        style="width: 60px; height: 60px; object-fit: contain; border: 1px solid #e8e8e8; border-radius: 4px; cursor: pointer;"
                    >
                    {{/each}}
                </div>
                {{/if}}
            {{else}}
                <div style="
                    width: 100%;
                    aspect-ratio: 1 / 1;
                    background: #f2f2f2;
                    border-radius: 5px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #999;
                    font-size: 1rem;
                ">
                    Sin imagen
                </div>
            {{/if}}
        </div>

        <!-- info del producto -->
        <div style="padding-left: 40px;">
            {{#if product.code}}
            <p style="color: #999; margin-bottom: 6px;">Código de producto: {{product.code}}</p>
            {{/if}}
            <h1 style="text-align: left; color: #333; font-size: 1.9rem; font-weight: 600; line-height: 1.3; margin-bottom: 16px;">
                {{product.title}}
            </h1>

            <div style="margin-bottom: 20px;">
                {{#if product.oldPriceFormatted}}
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                    <span style="font-size: 1.3rem; color: #999; text-decoration: line-through;">{{product.oldPriceFormatted}}</span>
                    <span style="background: #0b3866; color: #fff; font-size: 1.3rem; font-weight: 700; padding: 2px 10px; border-radius: 12px;">-{{product.discountPercent}}% OFF</span>
                </div>
                {{/if}}
                <h2 style="color: #333; font-size: 2rem;">
                    {{product.priceFormatted}}
                </h2>
            </div>

            <div style="margin-bottom: 20px;">
                <span style="
                    background: {{#if product.status}}#28a745{{else}}#dc3545{{/if}};
                    color: white;
                    padding: 8px 16px;
                    border-radius: 20px;
                    font-size: 0.9rem;
                ">
                    {{#if product.status}}✓ Disponible{{else}}✗ Agotado{{/if}}
                </span>
            </div>

            <div style="
                background: #f8f9fa;
                padding: 20px;
                border-radius: 8px;
                margin-bottom: 25px;
            ">
                <p style="margin-bottom: 10px;">
                    <strong>Categoría:</strong> {{product.category}}
                </p>
                <p style="margin-bottom: 10px;">
                    <strong>Stock:</strong> {{product.stock}} unidades
                </p>
                <p>
                    <strong>Estado:</strong>
                    {{#if product.status}}Activo{{else}}Inactivo{{/if}}
                </p>
            </div>

            {{#if product.status}}
                <div style="display: flex; gap: 10px; margin-bottom: 15px; align-items: center;">
                    <label style="font-weight: bold;">Cantidad:</label>
                    <input
                        type="number"
                        id="quantity"
                        value="1"
                        min="1"
                        max="{{product.stock}}"
                        style="
                            width: 80px;
                            padding: 8px;
                            border: 1px solid #ddd;
                            border-radius: 6px;
                            font-size: 1rem;
                        "
                    >
                </div>

                <button
                    onclick="addToCart('{{product._id}}')"
                    class="btn"
                    style="width: 100%; font-size: 1.1rem;"
                >
                    Agregar al carrito
                </button>
            {{else}}
                <button
                    class="btn"
                    disabled
                    style="opacity: 0.5; cursor: not-allowed; width: 100%;"
                >
                    Producto no disponible
                </button>
            {{/if}}
        </div>
    </div>

    <!-- sección separada de descripción -->
    <div style="margin-top: 40px; margin-bottom: 60px; border-top: 1px solid #e8e8e8; padding-top: 25px;">
        <h2 style="color: #333; font-size: 1.3rem; margin-bottom: 15px;">Descripción</h2>
        <p style="color: #666; line-height: 1.7; font-size: 1rem;">
            {{product.description}}
        </p>
    </div>
</div>

<script>
    async function addToCart(productId) {
        const quantity = parseInt(document.getElementById('quantity')?.value || 1);

        if (!quantity || quantity < 1) {
            alert('Cantidad inválida');
            return;
        }

        const cartId = localStorage.getItem('cartId');
        if (!cartId) {
            alert('No hay carrito disponible');
            return;
        }

        try {
            for (let i = 0; i < quantity; i++) {
                await fetch(`/api/carts/${cartId}/product/${productId}`, {
                    method: 'POST'
                });
            }

            alert(`${quantity} producto(s) agregado(s) al carrito`);
        } catch (error) {
            console.error('Error:', error);
            alert('Error al agregar al carrito');
        }
    }
</script>
