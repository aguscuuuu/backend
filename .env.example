# ── servidor ────────────────────────────────────────────
PORT=8080
NODE_ENV=development     # development | production | test

# ── base de datos ──────────────────────────────────────
MONGO_URL=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ── sesiones (express-session + connect-mongo) ──────────
SESSION_SECRET=cambiar_por_valor_aleatorio_largo_y_seguro

# ── jwt ─────────────────────────────────────────────────
# clave para firmar tokens. usar al menos 32 caracteres aleatorios en producción.
JWT_SECRET=cambiar_por_clave_secreta_larga_y_segura

# ── oauth github ────────────────────────────────────────
# registrar la app en: https://github.com/settings/developers
# authorization callback url: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=tu_github_client_id
GITHUB_CLIENT_SECRET=tu_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# ── legacy (no usar en producción) ──────────────────────
COOKIE_KEY=cambiar_por_valor_seguro
