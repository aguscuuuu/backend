# ── Server ────────────────────────────────────────────
PORT=8080
NODE_ENV=development     # development | production | test

# ── Database ──────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ── Sessions (express-session + connect-mongo) ────────
SESSION_SECRET=replace_with_a_long_random_secure_value

# ── JWT ───────────────────────────────────────────────
# Key used to sign tokens. Use at least 32 random characters in production.
JWT_SECRET=replace_with_a_long_secure_secret_key

# ── OAuth GitHub ──────────────────────────────────────
# Register the app at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# ── Legacy (do not use in production) ────────────────
COOKIE_KEY=replace_with_a_secure_value
